{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "node"
    ],
    "baseUrl": ".",
    "paths": {
      "@builder-internal/*": [
        "../Builder.ts/dist/*.d.ts"
      ]
    },
    "allowJs": true,
    "ignoreDeprecations": "6.0",
    "customConditions": [
      "source"
    ]
  }
}

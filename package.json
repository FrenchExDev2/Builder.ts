{
  "name": "@frenchexdev2/builder-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22.22"
  },
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 run build",
    "test": "pwsh -NoProfile -File packages/Builder.Tests.ts/scripts/Invoke-Validation.ps1 -Phase Tests",
    "test:mutation": "pwsh -NoProfile -File packages/Builder.Tests.ts/scripts/Invoke-Validation.ps1 -Phase Mutation",
    "test:linux": "pwsh -NoProfile -File packages/Builder.Tests.ts/scripts/Invoke-Validation.ps1 -Phase Linux",
    "test:ci": "node scripts/check-boundaries.mjs && node packages/Builder.Tests.ts/scripts/run.mjs --check && pnpm --filter @frenchexdev2/builder-tests run typecheck && pnpm --filter @frenchexdev2/builder-tests run test --coverage && pnpm --filter @frenchexdev2/builder run generate:check",
    "test:release": "node --test test/release.test.mjs",
    "release:prepare": "node scripts/release.mjs prepare",
    "release:check": "node scripts/release.mjs check"
  },
  "devDependencies": {
    "@typescript/native": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "@stryker-mutator/core": "catalog:",
    "@stryker-mutator/vitest-runner": "catalog:"
  }
}
